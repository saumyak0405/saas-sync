# Copy to .env, fill in, then: set -a; source .env; set +a
PG_URL=jdbc:postgresql://localhost:5432/warehouse
PG_USER=postgres
PG_PASSWORD=postgres

# Stripe: Dashboard > Developers > API keys, in test mode.
# Best practice: a restricted key (rk_test_...) with read-only access to the synced objects.
STRIPE_API_KEY=sk_test_replace_me

# GitHub: any repository you can read. A token is optional for public repos
# (fine-grained token with read-only "Issues", "Pull requests" and "Contents").
GITHUB_REPO=owner/name
GITHUB_TOKEN=
